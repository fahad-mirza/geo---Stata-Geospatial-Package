<?xml version="1.0" encoding="UTF-8"?>
<!--
  geo-io: reading and writing spatial data, with no Stata dependency.
  Phase 0 task 3 adds the first libraries: GeoTools' GeoTIFF module and EPSG database (versions
  from the GeoTools BOM in the parent pom) and the DuckDB JDBC driver. Later: DuckDB's spatial
  extension for vectors, and WKB (the standard binary geometry format) encoding and decoding.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.fahadmirza.geo</groupId>
    <artifactId>geo-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>geo-io</artifactId>
  <name>geo-io (reading rasters and vectors)</name>

  <dependencies>
    <dependency>
      <groupId>org.fahadmirza.geo</groupId>
      <artifactId>geo-core</artifactId>
    </dependency>
    <!-- GeoTIFF reading and writing (brings gt-coverage, gt-referencing, ImageN, ImageIO-Ext, JTS) -->
    <dependency>
      <groupId>org.geotools</groupId>
      <artifactId>gt-geotiff</artifactId>
    </dependency>
    <!-- The EPSG database of coordinate systems (EPSG:4326 and so on), stored in HSQLDB -->
    <dependency>
      <groupId>org.geotools</groupId>
      <artifactId>gt-epsg-hsql</artifactId>
    </dependency>
    <!-- DuckDB: main jar plus the Windows ARM64 native library -->
    <dependency>
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
      <classifier>windows_arm64</classifier>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
