<?xml version="1.0" encoding="UTF-8"?>
<!--
  geo-core: the engine's foundations, with no dependency on Stata or on any geospatial library.
  Holds: version information, the missing-value convention, numeric tolerances, and (Phase 0
  task 9) the thread pool and fixed-order chunking. Its tests run on every CI runner.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.fahadmirza.geo</groupId>
    <artifactId>geo-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>geo-core</artifactId>
  <name>geo-core (engine foundations)</name>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Filtering fills ${project.version} and ${geo.build} into geo-build.properties. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
  </build>
</project>
